# Template for `.env`. Copy once on the target server and fill in:
#
#   cp .env.example .env
#   $EDITOR .env
#   npm run check:env      # checks the values without building
#   npm run build
#
# `VITE_*` variables are baked into the bundle at build time, not read at runtime: after
# every change here, run `npm run build` again. The build applies the same rules as
# `check:env` and aborts on unusable values.
#
# `.env` is not in the repository (see .gitignore) – a `git pull` never overwrites it.

# --- Sync (optional; without these two values the app runs purely locally) --------------
#
# Both from Project Settings → API. The anon key is public and may be in the frontend –
# protection comes from row level security, not from the key. The `service_role` key never
# belongs here: it bypasses all RLS, and everything prefixed with `VITE_` is publicly
# readable after the build.
#
# Setting only one of the two lines is always an error and aborts the build.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Buying a subscription (optional; without this value the app shows no buy button) ----
#
# Only for a hosted service that sells sync (docs/billing.md). A self-hosted installation
# leaves this empty and turns off the subscription requirement in the database:
#   update private.settings set require_subscription = false;
#
# Hosted LemonSqueezy checkout page for the sync subscription, from the price variant under
# Share → Copy checkout URL. Hosted rather than overlay on purpose: the overlay would load
# third-party script and thus force loosening the CSP.
#
# The app appends the Supabase user ID as checkout[custom][user_id] itself – so enter the
# bare URL here, without that parameter.
VITE_LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/buy/<variant-uuid>

# --- Google Play Billing (optional; only for a hosted service with a Play Store app) -----
#
# `on`: in an Android app from Google Play (TWA, platform `twa`), the subscription is sold
# via Google Play. Empty or `off`: that app offers no purchase. Browsers and the Android app
# for direct download (platform `android`) are never affected; LemonSqueezy always applies
# there. Only enable once server-side Play purchase verification (not part of this
# repository) is deployed and the subscription product exists in the Play Console.
VITE_PLAY_BILLING=

# --- Usage stats (optional; set on the production server only) --------------------------
#
# `on`: the app reports every start to /beacon – without a device ID and without storing
# anything in the browser. nginx writes this to a separate log, from which an external
# report job derives counts (see deploy/nginx/tidypepple.conf). Leave empty on test and LAN
# servers, or they will be counted too.
VITE_BEACON=
